---
import SectionHeading from './SectionHeading.astro';
import { weddingConfig } from '../config/wedding.config';
const { hotels } = weddingConfig;
---

<section class="py-20 px-6 relative bg-paper-alt" id="hospedaje">
  <SectionHeading
    numeral="V"
    label="Estadía & Traslados"
    title="Hoteles Recomendados"
    intro="Para mayor comodidad de quienes viajan, gestionamos tarifas especiales en hoteles cercanos:"
  />

  <div class="space-y-6 max-w-sm mx-auto">
    {hotels.map((hotel) => (
      <div class="bg-card border border-line p-5 text-left space-y-3">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-display text-2xl font-normal text-ink leading-tight">
            {hotel.name}
          </h3>
          <span class="inline-block px-2 py-0.5 border border-accent/40 text-[11px] font-body font-medium tracking-wider text-accent shrink-0">
            {hotel.distance}
          </span>
        </div>

        <p class="font-body text-sm text-ink">📍 {hotel.address}</p>

        {hotel.discountCode && (
          <div class="bg-paper p-3 border border-line flex items-center justify-between text-xs font-body">
            <div>
              <span class="text-[11px] text-ink-soft block">Código de descuento:</span>
              <span class="font-mono font-bold text-ink">{hotel.discountCode}</span>
            </div>
            <span class="text-[11px] uppercase tracking-[0.15em] text-accent font-semibold">Tarifa Boda</span>
          </div>
        )}

        <div class="pt-2 flex items-center gap-2">
          <a
            href={`tel:${hotel.phone.replace(/[^0-9+]/g, '')}`}
            class="flex-1 h-11 border border-accent text-accent hover:bg-accent hover:text-paper transition-colors flex items-center justify-center gap-1.5 text-xs font-body font-medium tracking-wide"
          >
            <span>📞 Llamar</span>
          </a>
          <a
            href={hotel.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 h-11 bg-accent text-paper hover:bg-accent-strong transition-colors flex items-center justify-center gap-1.5 text-xs font-body font-medium tracking-wide"
          >
            <span>Web Hotel</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
