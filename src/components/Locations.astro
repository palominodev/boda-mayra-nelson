---
import SectionHeading from './SectionHeading.astro';
import { weddingConfig } from '../config/wedding.config';
const { venues } = weddingConfig;
---

<section class="py-20 px-6 relative bg-paper" id="ubicaciones">
  <SectionHeading
    numeral="IV"
    label="Dónde & Cuándo"
    title="Sedes & Cómo Llegar"
    intro="Accedé con un toque a tu app de navegación preferida para llegar sin demoras."
  />

  <div class="space-y-8 max-w-sm mx-auto">
    <!-- Ceremony Venue Card -->
    <div class="bg-card border border-line p-6 flex flex-col justify-between" data-reveal>
      <div>
        <div class="flex items-center justify-between gap-2 mb-4">
          <span class="inline-block px-2.5 py-1 border border-accent/40 text-[11px] uppercase tracking-[0.2em] font-medium font-body text-accent">
            {venues.ceremony.type}
          </span>
          <span class="font-body text-xs font-medium tracking-wider text-ink">{venues.ceremony.time}</span>
        </div>

        <h3 class="font-display text-2xl font-normal text-ink leading-tight mb-2">
          {venues.ceremony.name}
        </h3>

        <p class="font-body text-sm text-ink mb-1">
          📍 {venues.ceremony.address}, {venues.ceremony.city}
        </p>

        {venues.ceremony.notes && (
          <p class="font-body text-xs text-ink-soft italic mt-3 bg-paper p-3 border border-line">
            ℹ️ {venues.ceremony.notes}
          </p>
        )}
      </div>

      <!-- Navigation Buttons -->
      <div class="grid grid-cols-2 gap-2 mt-5 pt-5 border-t border-line">
        <a
          href={venues.ceremony.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="h-11 inline-flex items-center justify-center gap-1.5 px-3 bg-paper hover:bg-paper-alt text-ink text-xs font-body font-medium tracking-wide transition-colors border border-line"
        >
          <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          <span>Google Maps</span>
        </a>

        <a
          href={venues.ceremony.wazeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="h-11 inline-flex items-center justify-center gap-1.5 px-3 bg-paper hover:bg-paper-alt text-ink text-xs font-body font-medium tracking-wide transition-colors border border-line"
        >
          <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm3.5 11a1.5 1.5 0 111.5-1.5 1.5 1.5 0 01-1.5 1.5zm-7 0A1.5 1.5 0 1110 11.5 1.5 1.5 0 018.5 13z"/>
          </svg>
          <span>Waze</span>
        </a>
      </div>
    </div>

    <!-- Reception Venue Card -->
    <div class="bg-card border border-line p-6 flex flex-col justify-between" data-reveal>
      <div>
        <div class="flex items-center justify-between gap-2 mb-4">
          <span class="inline-block px-2.5 py-1 border border-accent/40 text-[11px] uppercase tracking-[0.2em] font-medium font-body text-accent">
            {venues.reception.type}
          </span>
          <span class="font-body text-xs font-medium tracking-wider text-ink">{venues.reception.time}</span>
        </div>

        <!-- Reception Venue Photo -->
        <div class="frame-marks my-5">
          <div class="w-full h-40 overflow-hidden bg-paper-alt">
            <img
              src="/images/venue-reception.jpg"
              alt="Estancia Bella Vista"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <h3 class="font-display text-2xl font-normal text-ink leading-tight mb-2">
          {venues.reception.name}
        </h3>

        <p class="font-body text-sm text-ink mb-1">
          📍 {venues.reception.address}, {venues.reception.city}
        </p>

        {venues.reception.notes && (
          <p class="font-body text-xs text-ink-soft italic mt-3 bg-paper p-3 border border-line">
            ℹ️ {venues.reception.notes}
          </p>
        )}
      </div>

      <!-- Navigation Buttons -->
      <div class="grid grid-cols-2 gap-2 mt-5 pt-5 border-t border-line">
        <a
          href={venues.reception.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="h-11 inline-flex items-center justify-center gap-1.5 px-3 bg-paper hover:bg-paper-alt text-ink text-xs font-body font-medium tracking-wide transition-colors border border-line"
        >
          <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          <span>Google Maps</span>
        </a>

        <a
          href={venues.reception.wazeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="h-11 inline-flex items-center justify-center gap-1.5 px-3 bg-paper hover:bg-paper-alt text-ink text-xs font-body font-medium tracking-wide transition-colors border border-line"
        >
          <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm3.5 11a1.5 1.5 0 111.5-1.5 1.5 1.5 0 01-1.5 1.5zm-7 0A1.5 1.5 0 1110 11.5 1.5 1.5 0 018.5 13z"/>
          </svg>
          <span>Waze</span>
        </a>
      </div>
    </div>
  </div>
</section>
