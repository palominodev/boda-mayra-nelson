---
import { weddingConfig } from '../config/wedding.config';
const { couple, coordinator } = weddingConfig;
---

<footer class="pt-16 pb-24 px-6 text-center bg-paper-alt border-t border-line safe-bottom relative">
  <!-- Monogram ornament -->
  <div class="flex items-center justify-center gap-3 mb-8" aria-hidden="true">
    <span class="w-10 h-px bg-accent/60"></span>
    <span class="font-display italic text-xl text-accent tracking-widest">{couple.initials}</span>
    <span class="w-10 h-px bg-accent/60"></span>
  </div>

  <!-- Hashtag Badge -->
  <div class="mb-10">
    <span class="text-[11px] uppercase font-body tracking-[0.3em] text-ink-soft block mb-2">Hashtag Oficial</span>
    <span class="inline-block px-4 py-2 border border-line bg-card text-xs font-mono font-semibold text-ink">
      {couple.hashtag}
    </span>
  </div>

  <!-- Emergency Coordinator Card (Anti-novios calling) -->
  <div class="bg-card p-5 border border-line max-w-sm mx-auto mb-12 text-left">
    <div class="flex items-start gap-3">
      <div class="w-10 h-10 rounded-full border border-accent/40 text-accent flex items-center justify-center shrink-0 text-base" aria-hidden="true">
        💬
      </div>
      <div class="flex-1">
        <span class="text-[11px] uppercase font-body tracking-[0.2em] text-ink-soft block">{coordinator.role}</span>
        <h4 class="text-sm font-body font-semibold text-ink">{coordinator.name}</h4>
        <p class="text-xs text-ink-soft font-body mt-1 leading-snug">
          ¿Dudas sobre traslados o accesos? Escribile directamente:
        </p>
        <a
          href={coordinator.whatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 mt-3 px-4 min-h-11 bg-accent hover:bg-accent-strong text-paper text-xs font-body font-medium tracking-wide transition-colors"
        >
          <span>Consultar por WhatsApp</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <p class="font-display italic text-3xl text-ink mb-3">
    Nelson & Mayra
  </p>
  <p class="text-xs font-body text-ink-soft">
    Con amor, los esperamos para celebrar juntos.
  </p>
</footer>
