---
import { weddingConfig } from '../config/wedding.config';
const { couple, coordinator } = weddingConfig;
---

<footer class="pt-10 pb-16 px-6 text-center bg-[#F9F6F0] border-t border-[#E8E3DC] safe-bottom relative">
  <!-- Monogram -->
  <div class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-[#C5A880]/50 bg-white mb-4">
    <span class="font-serif text-sm font-semibold tracking-wider text-[#1C1917]">{couple.initials}</span>
  </div>

  <!-- Hashtag Badge -->
  <div class="mb-6">
    <span class="text-[10px] uppercase font-sans tracking-widest text-[#6B6560] block mb-1">Hashtag Oficial</span>
    <span class="inline-block px-4 py-1.5 rounded-full bg-white border border-[#E8E3DC] text-xs font-mono font-semibold text-[#1C1917]">
      {couple.hashtag}
    </span>
  </div>

  <!-- Emergency Coordinator Card (Anti-novios calling) -->
  <div class="bg-white rounded-2xl p-4 border border-[#E8E3DC] max-w-xs mx-auto mb-8 shadow-xs text-left">
    <div class="flex items-start gap-3">
      <div class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 text-base">
        💬
      </div>
      <div class="flex-1">
        <span class="text-[10px] uppercase font-sans tracking-wider text-[#6B6560] block">{coordinator.role}</span>
        <h4 class="text-xs font-sans font-bold text-[#1C1917]">{coordinator.name}</h4>
        <p class="text-[11px] text-[#6B6560] font-sans mt-0.5 leading-snug">
          ¿Dudas sobre traslados o accesos? Escribile directamente:
        </p>
        <a
          href={coordinator.whatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 mt-2.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-sans font-semibold transition-colors"
        >
          <span>Consultar por WhatsApp</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <p class="font-serif italic text-lg text-[#1C1917] mb-2">
    Nelson & Mayra
  </p>
  <p class="text-[11px] font-sans text-[#6B6560]">
    Con amor, los esperamos para celebrar juntos.
  </p>
</footer>
