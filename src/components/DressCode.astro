---
import SectionHeading from './SectionHeading.astro';
import { weddingConfig } from '../config/wedding.config';
const { dressCode } = weddingConfig;
---

<section class="py-20 px-6 relative bg-paper" id="dresscode">
  <SectionHeading numeral="VI" label="Código de Vestimenta" title="Dress Code" />

  <div class="bg-card border border-line p-6 max-w-sm mx-auto text-center" data-reveal>
    <!-- Category Badge -->
    <div class="inline-block px-4 py-1.5 bg-accent text-paper text-xs font-body font-medium tracking-[0.2em] uppercase mb-5">
      {dressCode.category}
    </div>

    <p class="text-sm text-ink font-body leading-relaxed mb-8">
      {dressCode.description}
    </p>

    <!-- Color Swatches -->
    <div class="mb-8">
      <span class="text-[11px] font-body font-medium text-ink-soft block mb-4 uppercase tracking-[0.2em]">
        Paleta de Inspiración Sugerida
      </span>
      <div class="flex items-start justify-center gap-3">
        {dressCode.swatches.map((swatch) => (
          <div class="flex flex-col items-center group">
            <div
              class="w-9 h-9 rounded-full border border-ink/15 motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:scale-110"
              style={`background-color: ${swatch.hex};`}
              title={swatch.name}
            ></div>
            <span class="text-[11px] font-body text-ink-soft mt-1.5 max-w-[60px] leading-tight line-clamp-2">
              {swatch.name}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Shoe Advice Notice -->
    <div class="bg-paper p-4 text-left border border-line mb-4">
      <div class="flex items-start gap-3">
        <span class="text-base" aria-hidden="true">👠</span>
        <div>
          <h4 class="text-xs font-body font-semibold uppercase tracking-[0.15em] text-ink mb-1">Sugerencia de Calzado</h4>
          <p class="text-xs font-body text-ink-soft leading-relaxed">
            {dressCode.shoeAdvice}
          </p>
        </div>
      </div>
    </div>

    <!-- Reserved Colors Warning -->
    <div class="bg-paper-alt p-4 text-left border border-line border-l-2 border-l-accent">
      <div class="flex items-start gap-3">
        <span class="text-base" aria-hidden="true">🤍</span>
        <div>
          <h4 class="text-xs font-body font-semibold uppercase tracking-[0.15em] text-ink mb-1">Nota Especial</h4>
          <p class="text-xs font-body text-ink-soft leading-relaxed">
            {dressCode.reservedNote}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
