---
import SectionHeading from './SectionHeading.astro';
import { weddingConfig } from '../config/wedding.config';
const { timeline } = weddingConfig;
---

<section class="py-20 px-6 relative bg-paper-alt" id="itinerario">
  <SectionHeading numeral="III" label="Cronograma del Día" title="Itinerario de la Celebración" />

  <!-- Vertical Timeline Container -->
  <div class="relative max-w-xs mx-auto">
    <!-- Continuous hairline rail -->
    <div class="absolute left-[5px] top-2 bottom-2 w-px bg-line" aria-hidden="true" data-reveal="rail"></div>

    <div class="space-y-10">
      {timeline.map((item, index) => (
        <div class="relative pl-9" data-reveal>
          <!-- Timeline marker: small rotated square -->
          <span class="absolute left-0 top-1.5 w-[11px] h-[11px] rotate-45 bg-accent ring-4 ring-paper-alt" aria-hidden="true"></span>

          <div class="flex items-baseline justify-between gap-2 mb-1">
            <span class="font-body text-xs font-medium tracking-[0.2em] text-accent uppercase">
              {item.time} HS
            </span>
            <span class="font-body text-[11px] text-ink-soft">Paso {index + 1}</span>
          </div>

          <h3 class="font-display text-2xl font-normal text-ink leading-snug mb-1">
            {item.title}
          </h3>

          <p class="font-body text-sm text-ink-soft leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
