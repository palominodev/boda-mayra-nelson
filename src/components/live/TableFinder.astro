---
import { weddingConfig } from '../../config/wedding.config';
const { seatingChart } = weddingConfig;
---

<div class="space-y-6" id="table-finder-module">
  <!-- Search Header -->
  <div class="bg-white border border-[#E8E3DC] rounded-3xl p-5 shadow-xs text-left space-y-3">
    <div class="flex items-center gap-2.5">
      <span class="text-xl">🪑</span>
      <div>
        <h3 class="font-serif text-lg font-semibold text-[#1C1917]">Buscador de Mesas</h3>
        <p class="text-[11px] font-sans text-[#6B6560]">Ingresá tu nombre o apellido para encontrar tu lugar.</p>
      </div>
    </div>

    <!-- Search Input -->
    <div class="relative">
      <input
        type="text"
        id="table-search-input"
        placeholder="Ej: González, Carolina, Silva..."
        class="w-full h-12 pl-10 pr-4 rounded-xl border border-[#E8E3DC] bg-[#FDFBF7] text-xs font-sans text-[#1C1917] focus:outline-hidden focus:border-[#C5A880] focus:ring-2 focus:ring-[#C5A880]/20"
      />
      <svg class="w-4 h-4 text-[#6B6560] absolute left-3.5 top-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- Result Container -->
  <div id="table-search-result" class="hidden">
    <!-- Populated by script -->
  </div>

  <!-- All Tables Accordion / Reference List -->
  <div class="space-y-3 text-left">
    <span class="text-[11px] font-sans uppercase tracking-wider text-[#6B6560] font-bold block px-1">
      Distribución de Mesas
    </span>

    {seatingChart.map((table) => (
      <div class="bg-white rounded-2xl p-4 border border-[#E8E3DC] shadow-xs table-item" data-guests={table.guests.join(', ').toLowerCase()}>
        <div class="flex items-center justify-between mb-2">
          <span class="font-serif text-sm font-bold text-[#1C1917]">
            Mesa {table.tableNumber}
          </span>
          <span class="text-[10px] uppercase font-sans font-semibold bg-[#C5A880]/15 text-[#9A7B4F] px-2 py-0.5 rounded-full">
            {table.guests.length} Lugares
          </span>
        </div>
        <p class="text-xs font-serif italic text-[#C5A880] mb-2">{table.tableName}</p>
        <p class="text-[11px] font-sans text-[#44403C] leading-relaxed">
          {table.guests.join(' • ')}
        </p>
      </div>
    ))}
  </div>
</div>

<script>
  function setupTableFinder() {
    const input = document.getElementById('table-search-input') as HTMLInputElement;
    const resultBox = document.getElementById('table-search-result');
    const tableItems = document.querySelectorAll('.table-item');

    if (!input || !resultBox) return;

    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();

      if (!query || query.length < 2) {
        resultBox.classList.add('hidden');
        resultBox.innerHTML = '';
        tableItems.forEach((item) => (item as HTMLElement).style.display = 'block');
        return;
      }

      let found = false;

      tableItems.forEach((item) => {
        const guests = item.getAttribute('data-guests') || '';
        const el = item as HTMLElement;
        if (guests.includes(query)) {
          el.style.display = 'block';
          el.classList.add('ring-2', 'ring-[#C5A880]');
          found = true;
        } else {
          el.style.display = 'none';
          el.classList.remove('ring-2', 'ring-[#C5A880]');
        }
      });

      if (found) {
        resultBox.classList.remove('hidden');
        resultBox.innerHTML = `
          <div class="bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-2xl p-4 text-left shadow-xs animate-fade-in">
            <span class="text-xs font-bold block mb-0.5">🎯 ¡Lugar encontrado!</span>
            <span class="text-xs">Mirá la mesa resaltada a continuación para ver tus acompañantes.</span>
          </div>
        `;
      } else {
        resultBox.classList.remove('hidden');
        resultBox.innerHTML = `
          <div class="bg-amber-50 border border-amber-200 text-amber-900 rounded-2xl p-4 text-left shadow-xs animate-fade-in">
            <span class="text-xs font-bold block mb-0.5">🔍 No encontramos ese nombre exacto</span>
            <span class="text-xs">Probá con tu apellido o consultá a la wedding planner en la entrada.</span>
          </div>
        `;
      }
    });
  }

  setupTableFinder();
</script>
