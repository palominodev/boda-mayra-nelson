---
import { weddingConfig } from '../../config/wedding.config';
const { wifi } = weddingConfig;
---

<div class="bg-white border border-[#E8E3DC] rounded-3xl p-5 shadow-xs text-left space-y-4">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-sky-50 text-sky-600 flex items-center justify-center text-lg">
      📶
    </div>
    <div>
      <h3 class="font-serif text-lg font-semibold text-[#1C1917]">WiFi del Salón</h3>
      <p class="text-[11px] font-sans text-[#6B6560]">Conectate gratis para subir fotos y compartir momentos.</p>
    </div>
  </div>

  <div class="bg-[#F9F6F0] rounded-2xl p-4 border border-[#E8E3DC] space-y-3">
    <div>
      <span class="text-[10px] uppercase font-sans tracking-wider text-[#6B6560] block">Red (SSID)</span>
      <span class="text-xs font-mono font-bold text-[#1C1917]">{wifi.ssid}</span>
    </div>

    <div class="pt-2 border-t border-[#E8E3DC] flex items-center justify-between gap-2">
      <div>
        <span class="text-[10px] uppercase font-sans tracking-wider text-[#6B6560] block">Contraseña</span>
        <span class="text-xs font-mono font-bold text-[#1C1917]" id="wifi-pass-val">{wifi.password}</span>
      </div>
      <button
        type="button"
        id="btn-copy-wifi"
        class="px-3 py-1.5 rounded-lg bg-white border border-[#C5A880] text-[#9A7B4F] text-xs font-sans font-semibold hover:bg-[#C5A880]/10 transition-colors flex items-center gap-1 active:scale-95 cursor-pointer"
        data-copy={wifi.password}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span>Copiar Clave</span>
      </button>
    </div>
  </div>
</div>

<script>
  function setupWifiCopy() {
    const btn = document.getElementById('btn-copy-wifi');
    btn?.addEventListener('click', async () => {
      const pass = btn.getAttribute('data-copy');
      if (!pass) return;
      try {
        await navigator.clipboard.writeText(pass);
        const origText = btn.innerHTML;
        btn.innerHTML = '<span>✓ Copiado</span>';
        setTimeout(() => {
          btn.innerHTML = origText;
        }, 2000);
      } catch (err) {
        console.error(err);
      }
    });
  }

  setupWifiCopy();
</script>
