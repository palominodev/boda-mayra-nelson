---
import SectionHeading from './SectionHeading.astro';

const galleryItems = [
  {
    id: 1,
    title: 'La Propuesta',
    location: 'Bariloche, Río Negro',
    span: 'col-span-2',
    ratio: 'aspect-16/9',
    src: '/images/gallery-proposal.jpg',
  },
  {
    id: 2,
    title: 'Tardes de Café',
    location: 'San Telmo, Buenos Aires',
    span: '',
    ratio: 'aspect-square',
    src: '/images/gallery-cafe.jpg',
  },
  {
    id: 3,
    title: 'Viaje a la Costa',
    location: 'Mar de las Pampas',
    span: '',
    ratio: 'aspect-square',
    src: '/images/gallery-beach.jpg',
  },
  {
    id: 4,
    title: 'Nuestro Compromiso',
    location: 'Jardín Botánico',
    span: 'col-span-2',
    ratio: 'aspect-4/3',
    src: '/images/gallery-botanical.jpg',
  },
];
---

<section class="py-20 px-6 relative bg-paper" id="galeria">
  <SectionHeading
    numeral="II"
    label="Momentos Especiales"
    title="Nuestra Galería"
    intro="Algunos de los recuerdos más lindos de nuestro camino juntos."
  />

  <!-- Editorial Mosaic Grid -->
  <div class="grid grid-cols-2 gap-x-4 gap-y-6 max-w-sm mx-auto">
    {galleryItems.map((item) => (
      <div
        class={`group cursor-pointer text-left ${item.span}`}
        data-reveal
        role="button"
        tabindex="0"
        aria-label={`Ver foto: ${item.title}, ${item.location}`}
        data-lightbox-src={item.src}
        data-lightbox-title={item.title}
        data-lightbox-loc={item.location}
      >
        <!-- Real Stock Photo -->
        <div class={`relative overflow-hidden border border-line bg-paper-alt ${item.ratio}`}>
          <img
            src={item.src}
            alt={item.title}
            class="absolute inset-0 w-full h-full object-cover motion-safe:transition-transform motion-safe:duration-[1400ms] motion-safe:ease-editorial motion-safe:group-hover:scale-[1.06] motion-safe:group-focus-visible:scale-[1.06]"
            loading="lazy"
          />
        </div>

        <!-- Caption -->
        <div class="mt-2">
          <h4 class="font-display italic text-lg text-ink leading-tight">{item.title}</h4>
          <span class="font-body text-[11px] uppercase tracking-[0.15em] text-ink-soft block mt-0.5">{item.location}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Lightbox Modal -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-50 bg-ink/90 backdrop-blur-md flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300"
  >
    <div class="bg-card border border-line max-w-sm w-full p-4 text-center shadow-2xl relative">
      <button
        type="button"
        id="lightbox-close-btn"
        aria-label="Cerrar"
        class="absolute top-2 right-2 z-30 w-11 h-11 bg-card/90 border border-line text-ink flex items-center justify-center hover:bg-paper-alt cursor-pointer text-sm"
      >
        ✕
      </button>

      <div class="w-full h-72 overflow-hidden bg-paper-alt mb-4 border border-line relative">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="w-full h-full object-cover"
        />
      </div>

      <div class="px-2 pb-1">
        <h3 id="lightbox-title" class="font-display italic text-2xl text-ink mb-0.5">Título</h3>
        <p id="lightbox-loc" class="font-body text-[11px] uppercase tracking-[0.15em] text-ink-soft">Ubicación</p>
      </div>
    </div>
  </div>
</section>

<script>
  function setupGallery() {
    const items = document.querySelectorAll('[data-lightbox-src]');
    const lightbox = document.getElementById('gallery-lightbox');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const imgEl = document.getElementById('lightbox-img') as HTMLImageElement;
    const titleEl = document.getElementById('lightbox-title');
    const locEl = document.getElementById('lightbox-loc');

    if (!lightbox) return;

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const src = item.getAttribute('data-lightbox-src') || '';
        const title = item.getAttribute('data-lightbox-title') || '';
        const loc = item.getAttribute('data-lightbox-loc') || '';

        if (imgEl) imgEl.src = src;
        if (titleEl) titleEl.textContent = title;
        if (locEl) locEl.textContent = loc;

        lightbox.classList.remove('hidden');
        setTimeout(() => {
          lightbox.classList.remove('opacity-0');
        }, 10);
      });

      // Tiles are focusable buttons: Enter / Space opens them like a click
      item.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'Enter' || key === ' ') {
          e.preventDefault();
          (item as HTMLElement).click();
        }
      });
    });

    function closeLightbox() {
      lightbox?.classList.add('opacity-0');
      setTimeout(() => {
        lightbox?.classList.add('hidden');
      }, 300);
    }

    closeBtn?.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) closeLightbox();
    });
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  setupGallery();
</script>
