---
const galleryItems = [
  {
    id: 1,
    title: 'La Propuesta',
    location: 'Bariloche, Río Negro',
    aspect: 'col-span-2 aspect-16/9',
    src: '/images/gallery-proposal.jpg',
  },
  {
    id: 2,
    title: 'Tardes de Café',
    location: 'San Telmo, Buenos Aires',
    aspect: 'aspect-square',
    src: '/images/gallery-cafe.jpg',
  },
  {
    id: 3,
    title: 'Viaje a la Costa',
    location: 'Mar de las Pampas',
    aspect: 'aspect-square',
    src: '/images/gallery-beach.jpg',
  },
  {
    id: 4,
    title: 'Nuestro Compromiso',
    location: 'Jardín Botánico',
    aspect: 'col-span-2 aspect-4/3',
    src: '/images/gallery-botanical.jpg',
  },
];
---

<section class="py-12 px-6 border-b border-[#E8E3DC]/60 relative bg-[#FDFBF7]" id="galeria">
  <div class="text-center mb-8">
    <span class="text-[11px] uppercase tracking-[0.25em] text-[#6B6560] font-sans font-medium block mb-2">
      Momentos Especiales
    </span>
    <h2 class="font-serif text-3xl sm:text-4xl text-[#1C1917] font-normal tracking-tight">
      Nuestra Galería
    </h2>
    <p class="text-xs text-[#6B6560] font-sans mt-2 max-w-xs mx-auto">
      Algunos de los recuerdos más lindos de nuestro camino juntos.
    </p>
  </div>

  <!-- Editorial Mosaic Grid -->
  <div class="grid grid-cols-2 gap-3 max-w-xs mx-auto">
    {galleryItems.map((item) => (
      <div
        class={`group relative rounded-2xl overflow-hidden border border-[#E8E3DC] shadow-xs cursor-pointer bg-stone-100 flex flex-col justify-end p-3 transition-transform duration-300 hover:scale-[1.02] active:scale-98 ${item.aspect}`}
        data-lightbox-src={item.src}
        data-lightbox-title={item.title}
        data-lightbox-loc={item.location}
      >
        <!-- Real Stock Photo -->
        <img
          src={item.src}
          alt={item.title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />

        <!-- Photo Gradient Overlay for Text Legibility -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent z-10 pointer-events-none"></div>

        <!-- Caption -->
        <div class="relative z-20 text-white text-left">
          <h4 class="font-serif text-sm font-semibold leading-tight drop-shadow-xs">{item.title}</h4>
          <span class="text-[10px] text-white/80 font-sans block">{item.location}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Lightbox Modal -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300"
  >
    <div class="bg-white rounded-3xl max-w-sm w-full p-4 text-center shadow-2xl relative overflow-hidden">
      <button
        type="button"
        id="lightbox-close-btn"
        class="absolute top-3 right-3 z-30 w-8 h-8 rounded-full bg-white/90 text-[#1C1917] flex items-center justify-center hover:bg-stone-200 cursor-pointer text-sm font-bold shadow-md"
      >
        ✕
      </button>

      <div class="w-full h-72 rounded-2xl overflow-hidden bg-stone-100 mb-3 border border-[#E8E3DC] relative">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="w-full h-full object-cover"
        />
      </div>

      <div class="px-2 pb-1">
        <h3 id="lightbox-title" class="font-serif text-2xl text-[#1C1917] mb-0.5">Título</h3>
        <p id="lightbox-loc" class="text-xs font-sans text-[#6B6560]">Ubicación</p>
      </div>
    </div>
  </div>
</section>

<script>
  function setupGallery() {
    const items = document.querySelectorAll('[data-lightbox-src]');
    const lightbox = document.getElementById('gallery-lightbox');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const imgEl = document.getElementById('lightbox-img') as HTMLImageElement;
    const titleEl = document.getElementById('lightbox-title');
    const locEl = document.getElementById('lightbox-loc');

    if (!lightbox) return;

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const src = item.getAttribute('data-lightbox-src') || '';
        const title = item.getAttribute('data-lightbox-title') || '';
        const loc = item.getAttribute('data-lightbox-loc') || '';

        if (imgEl) imgEl.src = src;
        if (titleEl) titleEl.textContent = title;
        if (locEl) locEl.textContent = loc;

        lightbox.classList.remove('hidden');
        setTimeout(() => {
          lightbox.classList.remove('opacity-0');
        }, 10);
      });
    });

    function closeLightbox() {
      lightbox?.classList.add('opacity-0');
      setTimeout(() => {
        lightbox?.classList.add('hidden');
      }, 300);
    }

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  setupGallery();
</script>
