---
import SectionHeading from './SectionHeading.astro';
import { weddingConfig } from '../config/wedding.config';
const { gifts } = weddingConfig;
---

<section class="py-20 px-6 relative bg-paper-alt" id="regalos">
  <SectionHeading numeral="VII" label="Mesa de Regalos" title="Luna de Miel & Presentes" />

  <div class="bg-card border border-line p-6 max-w-sm mx-auto" data-reveal>
    <div class="w-12 h-12 rounded-full border border-accent/40 flex items-center justify-center mx-auto mb-5 text-accent">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
      </svg>
    </div>

    <p class="text-sm text-ink font-body leading-relaxed text-center mb-8">
      {gifts.message}
    </p>

    <!-- Bank Details Card -->
    <div class="bg-paper p-4 border border-line space-y-4 text-left">
      <div>
        <span class="text-[11px] uppercase font-body tracking-[0.2em] text-ink-soft block">Banco & Titular</span>
        <p class="text-sm font-body font-semibold text-ink mt-0.5">{gifts.bank} • {gifts.accountType}</p>
        <p class="text-sm font-body text-ink">{gifts.holder}</p>
      </div>

      <!-- Copyable Alias -->
      <div class="pt-3 border-t border-line flex items-center justify-between gap-2">
        <div>
          <span class="text-[11px] uppercase font-body tracking-[0.2em] text-ink-soft block">Alias</span>
          <span class="text-sm font-mono font-bold text-ink" id="alias-val">{gifts.alias}</span>
        </div>
        <button
          type="button"
          class="btn-copy min-h-11 px-4 border border-accent text-accent text-xs font-body font-medium tracking-wide hover:bg-accent hover:text-paper transition-colors flex items-center gap-1.5 cursor-pointer"
          data-copy={gifts.alias}
          data-label="Alias"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>Copiar</span>
        </button>
      </div>

      <!-- Copyable CBU -->
      <div class="pt-3 border-t border-line flex items-center justify-between gap-2">
        <div class="overflow-hidden">
          <span class="text-[11px] uppercase font-body tracking-[0.2em] text-ink-soft block">CBU</span>
          <span class="text-xs font-mono font-bold text-ink block truncate" id="cbu-val">{gifts.cbu}</span>
        </div>
        <button
          type="button"
          class="btn-copy min-h-11 px-4 border border-accent text-accent text-xs font-body font-medium tracking-wide hover:bg-accent hover:text-paper transition-colors flex items-center gap-1.5 shrink-0 cursor-pointer"
          data-copy={gifts.cbu}
          data-label="CBU"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>Copiar</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div
    id="toast-notification"
    role="status"
    aria-live="polite"
    class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 bg-ink text-paper px-5 py-2.5 text-xs font-body shadow-xl flex items-center gap-2 opacity-0 pointer-events-none transition-all duration-300 transform translate-y-2"
  >
    <svg class="w-4 h-4 text-accent-soft" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span id="toast-text">Copiado al portapapeles</span>
  </div>
</section>

<script>
  function setupCopyButtons() {
    const buttons = document.querySelectorAll('.btn-copy');
    const toast = document.getElementById('toast-notification');
    const toastText = document.getElementById('toast-text');
    let toastTimeout: any;

    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const textToCopy = btn.getAttribute('data-copy');
        const label = btn.getAttribute('data-label') || 'Dato';
        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);
          if (toast && toastText) {
            toastText.textContent = `¡${label} copiado al portapapeles!`;
            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
            toast.classList.add('opacity-100', 'translate-y-0');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
              toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
              toast.classList.remove('opacity-100', 'translate-y-0');
            }, 2500);
          }
        } catch (err) {
          console.error('Error al copiar al portapapeles:', err);
        }
      });
    });
  }

  setupCopyButtons();
</script>
