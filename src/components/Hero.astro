---
import Countdown from './Countdown.astro';
import { weddingConfig } from '../config/wedding.config';

const { couple, event, venues } = weddingConfig;

// Precomputed Google Calendar URL
const gCalDates = '20261121T200000Z/20261122T080000Z'; // UTC approximation
const gCalDetails = encodeURIComponent(
  `¡Nos casamos! Ceremonia en ${venues.ceremony.name} (${venues.ceremony.address}) y Fiesta en ${venues.reception.name}.\n\nConfirmá tu asistencia en nuestra web.`
);
const gCalLocation = encodeURIComponent(`${venues.ceremony.name}, ${venues.ceremony.address}`);
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.calendarTitle)}&dates=${gCalDates}&details=${gCalDetails}&location=${gCalLocation}`;
---

<header class="relative pt-8 pb-16 px-6 text-center flex flex-col items-center bg-paper">
  <!-- Ornament: initials between hairlines -->
  <div class="flex items-center justify-center gap-3 mb-6" aria-hidden="true" data-hero style="--delay:0ms">
    <span class="w-10 h-px bg-accent/60"></span>
    <span class="font-display italic text-base text-accent tracking-widest">{couple.initials}</span>
    <span class="w-10 h-px bg-accent/60"></span>
  </div>

  <!-- Editorial Subtitle -->
  <p class="font-body text-[11px] uppercase tracking-[0.3em] text-ink-soft font-medium mb-5" data-hero style="--delay:100ms">
    Nuestra Boda • {event.dayOfWeek}
  </p>

  <!-- Couple Names: giant tracked wordmark, surnames as small caps -->
  <h1 class="font-display uppercase font-light text-ink leading-none flex flex-col items-center">
    <span class="flex flex-col items-center" data-hero style="--delay:220ms">
      <span class="text-[3.5rem] sm:text-6xl tracking-[0.08em] mr-[-0.08em]">{couple.groom.split(' ')[0]}</span>
      <span class="font-body text-[11px] tracking-[0.45em] mr-[-0.45em] text-ink-soft mt-2">{couple.groom.split(' ').slice(1).join(' ')}</span>
    </span>
    <span class="font-display italic normal-case text-4xl text-accent my-2 font-light" data-hero style="--delay:340ms">&</span>
    <span class="flex flex-col items-center" data-hero style="--delay:460ms">
      <span class="text-[3.5rem] sm:text-6xl tracking-[0.08em] mr-[-0.08em]">{couple.bride.split(' ')[0]}</span>
      <span class="font-body text-[11px] tracking-[0.45em] mr-[-0.45em] text-ink-soft mt-2">{couple.bride.split(' ').slice(1).join(' ')}</span>
    </span>
  </h1>

  <!-- Hero Photo with corner registration marks -->
  <figure class="mt-8 mb-2 flex flex-col items-center" data-hero style="--delay:580ms">
    <div class="frame-marks w-44 h-56 group">
      <div class="w-full h-full overflow-hidden bg-paper-alt">
        <img
          src="/images/hero.jpg"
          alt="Nelson Montenegro y Mayra Palomino"
          class="w-full h-full object-cover object-center motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-105"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <figcaption class="font-display italic text-lg text-ink-soft mt-5">"El amor no se mira, se siente"</figcaption>
  </figure>

  <!-- Date & Location -->
  <div class="mt-6" data-hero style="--delay:760ms">
    <p class="font-display italic text-2xl text-ink">{event.displayDate}</p>
    <p class="font-body text-[11px] uppercase tracking-[0.3em] text-ink-soft mt-2">{event.city}</p>
  </div>

  <!-- Countdown Component Island -->
  <Countdown targetDate={event.dateIso} />

  <!-- Action Buttons: Add to Calendar & Quick RSVP -->
  <div class="flex flex-col gap-3 w-full max-w-xs" data-hero style="--delay:920ms">
    <!-- Add to Calendar Button with Dropdown -->
    <div class="relative w-full" id="cal-dropdown-root">
      <button
        type="button"
        id="cal-toggle-btn"
        class="w-full h-12 inline-flex items-center justify-center gap-2 px-5 border border-accent bg-transparent text-accent font-body text-xs font-medium tracking-[0.2em] uppercase transition-colors duration-200 hover:bg-accent hover:text-paper cursor-pointer"
        aria-expanded="false"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Agendar Fecha</span>
      </button>

      <!-- Calendar Options Menu -->
      <div
        id="cal-menu"
        class="hidden absolute left-0 right-0 top-14 bg-card border border-line shadow-md p-1 z-30 flex flex-col text-left"
      >
        <a
          href={googleCalendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 px-3 min-h-11 font-body text-xs text-ink hover:bg-paper-alt transition-colors"
        >
          <span class="w-1.5 h-1.5 bg-accent rotate-45" aria-hidden="true"></span>
          <span>Google Calendar</span>
        </a>
        <button
          type="button"
          id="btn-download-ics"
          class="flex items-center gap-3 px-3 min-h-11 font-body text-xs text-ink hover:bg-paper-alt transition-colors text-left w-full cursor-pointer"
        >
          <span class="w-1.5 h-1.5 bg-accent rotate-45" aria-hidden="true"></span>
          <span>Apple / Outlook (.ics)</span>
        </button>
      </div>
    </div>

    <!-- Quick Scroll to RSVP -->
    <a
      href="#rsvp"
      class="group w-full h-12 inline-flex items-center justify-center gap-2 px-5 bg-accent text-paper font-body text-xs font-medium tracking-[0.2em] uppercase transition-colors duration-200 hover:bg-accent-strong"
    >
      <span>Confirmar Asistencia</span>
      <svg class="w-3.5 h-3.5 motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</header>

<script>
  function setupCalendarDropdown() {
    const toggleBtn = document.getElementById('cal-toggle-btn');
    const menu = document.getElementById('cal-menu');
    const downloadIcsBtn = document.getElementById('btn-download-ics');

    if (!toggleBtn || !menu) return;

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggleBtn.setAttribute('aria-expanded', 'false');
    });

    if (downloadIcsBtn) {
      downloadIcsBtn.addEventListener('click', () => {
        const icsContent = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//Nelson & Mayra//Wedding Invitation//ES',
          'CALSCALE:GREGORIAN',
          'METHOD:PUBLISH',
          'BEGIN:VEVENT',
          'UID:wedding-nelson-mayra-20261121@boda.com',
          'DTSTAMP:20260923T120000Z',
          'DTSTART:20261121T200000Z',
          'DTEND:20261122T080000Z',
          'SUMMARY:Boda Nelson Montenegro y Mayra Palomino',
          'DESCRIPTION:Acompáñanos a celebrar nuestra boda. Ceremonia y Recepción.',
          'LOCATION:Basílica Nuestra Señora de la Merced, Reconquista 207, CABA',
          'STATUS:CONFIRMED',
          'END:VEVENT',
          'END:VCALENDAR',
        ].join('\r\n');

        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const link = document.createElement('a');
        link.href = window.URL.createObjectURL(blob);
        link.setAttribute('download', 'Boda-Nelson-y-Mayra.ics');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    }
  }

  setupCalendarDropdown();
</script>
