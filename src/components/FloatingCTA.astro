<div
  id="floating-rsvp-cta"
  class="fixed bottom-6 inset-x-0 mx-auto w-fit z-40 px-4 transition-all duration-300 transform translate-y-0 opacity-100"
>
  <a
    href="#rsvp"
    class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full bg-[#1C1917]/95 text-white font-sans text-xs font-semibold uppercase tracking-wider shadow-2xl backdrop-blur-md border border-white/20 transition-all hover:bg-[#332F2C] active:scale-95 group cursor-pointer"
  >
    <span class="w-2 h-2 rounded-full bg-[#C5A880] animate-pulse"></span>
    <span>Confirmar Asistencia</span>
    <svg class="w-3.5 h-3.5 text-[#C5A880] transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </a>
</div>

<script>
  function setupFloatingCTA() {
    const cta = document.getElementById('floating-rsvp-cta');
    const rsvpSection = document.getElementById('rsvp');
    if (!cta || !rsvpSection) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Hide CTA when in RSVP section to avoid covering form
            cta.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            cta.classList.remove('opacity-100', 'translate-y-0');
          } else {
            // Show CTA elsewhere
            cta.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
            cta.classList.add('opacity-100', 'translate-y-0');
          }
        });
      },
      {
        threshold: 0.15,
      }
    );

    observer.observe(rsvpSection);
  }

  setupFloatingCTA();
</script>
