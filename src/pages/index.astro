---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Timeline from '../components/Timeline.astro';
import Locations from '../components/Locations.astro';
import DressCode from '../components/DressCode.astro';
import Gifts from '../components/Gifts.astro';
import RSVP from '../components/RSVP.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { weddingConfig } from '../config/wedding.config';

const { couple, event } = weddingConfig;
const pageTitle = `${couple.groom} & ${couple.bride} | ${event.dayOfWeek} ${event.displayDate}`;
---

<Layout title={pageTitle}>
  <main class="w-full flex flex-col">
    <!-- 1. Hero Section with Names, Arch Portrait, Countdown & Add to Calendar -->
    <Hero />

    <!-- 2. Couple Welcome Letter & Story -->
    <Story />

    <!-- 3. Itinerary / Chronological Vertical Timeline -->
    <Timeline />

    <!-- 4. Venues & Navigation (Google Maps & Waze Anti-iframe Deep Links) -->
    <Locations />

    <!-- 5. Dress Code & Terrain/Shoe Guidance -->
    <DressCode />

    <!-- 6. Gifts, Honeymoon & 1-Tap Copyable Bank Details (CBU/Alias) -->
    <Gifts />

    <!-- 7. Interactive 3-Step Micro-Stepper RSVP with Confetti Reward -->
    <RSVP />

    <!-- 8. Footer & Emergency Coordinator Contact -->
    <Footer />
  </main>

  <!-- Persistent Floating Action Button (hides at RSVP section) -->
  <FloatingCTA />
</Layout>
