---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Gallery from '../components/Gallery.astro';
import Timeline from '../components/Timeline.astro';
import Locations from '../components/Locations.astro';
import Lodging from '../components/Lodging.astro';
import DressCode from '../components/DressCode.astro';
import Gifts from '../components/Gifts.astro';
import FAQ from '../components/FAQ.astro';
import RSVP from '../components/RSVP.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { weddingConfig } from '../config/wedding.config';

const { couple, event } = weddingConfig;
const pageTitle = `${couple.groom} & ${couple.bride} | ${event.dayOfWeek} ${event.displayDate}`;
---

<Layout title={pageTitle}>
  <!-- Landing ground: paper tokens and body face are scoped to this wrapper so /en-vivo keeps its own look -->
  <div class="landing flex-1 flex flex-col">
    <!-- Live Day-of Mode Fast Access Banner -->
    <aside class="bg-ink text-paper px-6 py-1 text-center text-xs font-body tracking-wide flex flex-wrap items-center justify-center gap-x-2 border-b border-accent-soft/30">
      <span class="w-1.5 h-1.5 rounded-full bg-accent-soft motion-safe:animate-ping" aria-hidden="true"></span>
      <span class="text-paper/90">¿Estás en la fiesta?</span>
      <a
        href="/en-vivo"
        class="inline-flex items-center min-h-11 text-accent-soft font-medium underline underline-offset-4 hover:text-paper transition-colors focus-visible:outline-accent-soft"
      >
        Modo En Vivo (Fotos, Mesas, WiFi) →
      </a>
    </aside>

    <main class="w-full flex flex-col">
      <!-- 1. Hero Section with Names, Arch Portrait, Countdown & Add to Calendar -->
      <Hero />

      <!-- 2. Couple Welcome Letter & Story -->
      <Story />

      <!-- 3. Photo Gallery & Engagement Moments -->
      <Gallery />

      <!-- 4. Itinerary / Chronological Vertical Timeline -->
      <Timeline />

      <!-- 5. Venues & Navigation (Google Maps & Waze Anti-iframe Deep Links) -->
      <Locations />

      <!-- 6. Lodging & Hotel Recommendations for Out-of-town Guests -->
      <Lodging />

      <!-- 7. Dress Code & Terrain/Shoe Guidance -->
      <DressCode />

      <!-- 8. Gifts, Honeymoon & 1-Tap Copyable Bank Details (CBU/Alias) -->
      <Gifts />

      <!-- 9. Frequently Asked Questions (FAQ Accordion) -->
      <FAQ />

      <!-- 10. Interactive 3-Step Micro-Stepper RSVP with Confetti Reward -->
      <RSVP />

      <!-- 11. Footer & Emergency Coordinator Contact -->
      <Footer />
    </main>

    <!-- Persistent Floating Action Button (hides at RSVP section) -->
    <FloatingCTA />
  </div>
</Layout>
